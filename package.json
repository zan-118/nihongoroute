{
  "name": "nihongoroute",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "db:migrations:check": "node scripts/check-migrations.mjs",
    "exam:import:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-jlpt-import.mjs",
    "exam:generate:moji-goi": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-jlpt-moji-goi.mjs",
    "exam:generate:bunpou": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-jlpt-bunpou.mjs",
    "exam:generate:dokkai": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-jlpt-dokkai.mjs",
    "exam:generate:choukai": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-jlpt-choukai.mjs",
    "pdf:generate:vocab-hinshi": "npx tsx scripts/generate-vocab-pdf.tsx",
    "pdf:generate:grammar": "npx tsx scripts/generate-grammar-pdf.tsx",
    "pdf:generate:lesson": "npx tsx scripts/generate-lesson-pdf.tsx",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@iconify/react": "^6.0.2",
    "@next/third-parties": "16.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.0",
    "@tanstack/react-query": "^5.100.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "idb-keyval": "^6.2.2",
    "msedge-tts": "^2.0.5",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "wanakana": "^5.3.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@gradio/client": "^2.3.1",
    "@next/bundle-analyzer": "16.2.12",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.11.30",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.12",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.4.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.22",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js --fix"
  }
}
