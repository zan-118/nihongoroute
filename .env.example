# Public browser-safe configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only Supabase and content operations
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Admin API Secret
ADMIN_API_SECRET=replace-with-long-random-secret

# AI and webhook integrations
GEMINI_API_KEY=replace-with-gemini-api-key
TRAKTEER_WEBHOOK_SECRET=replace-with-trakteer-secret
SAWERIA_WEBHOOK_SECRET=replace-with-saweria-secret
