# Public browser-safe configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only Supabase and content operations
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SANITY_API_READ_TOKEN=replace-with-server-only-read-token
SANITY_API_WRITE_TOKEN=replace-with-server-only-write-token

# Admin bridge used by Sanity Studio -> Next.js admin routes
ADMIN_API_SECRET=replace-with-long-random-secret
SANITY_STUDIO_ADMIN_API_SECRET=replace-with-same-admin-secret-for-studio

# AI and webhook integrations
GEMINI_API_KEY=replace-with-gemini-api-key
TRAKTEER_WEBHOOK_SECRET=replace-with-trakteer-secret
SAWERIA_WEBHOOK_SECRET=replace-with-saweria-secret
